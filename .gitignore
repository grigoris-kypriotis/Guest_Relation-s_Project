# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary Office lock files
~$*.doc*
~$*.xls*

# Environment and IDEs
.vscode/
.idea/
.env
*.venv
env/
venv/

# System files
Thumbs.db
Desktop.ini
.DS_Store

# Logs and temporary files
*.log
*.tmp
.*.tmp

# Sensitive Guest Data & Runtime Storage (NO JSONs, NO CSVs)
*.json
*.csv
!PLOT/HotelDataSet.json

# Runtime generated Excel & Word documents (Templates are tracked)
*.xlsx
*.xls
*.docx
!TEMPLATES/**

# Prevent tracking runtime generated outputs while preserving directory structure
DATABASE/**
!DATABASE/**/
!DATABASE/**/.gitkeep

BOOKING CALLS/**
!BOOKING CALLS/**/
!BOOKING CALLS/**/.gitkeep

TRASH/**
!TRASH/**/
!TRASH/**/.gitkeep

OUTPUT/**
!OUTPUT/**/
!OUTPUT/**/.gitkeep

# Whitelist all .gitkeep markers
!**/.gitkeep

